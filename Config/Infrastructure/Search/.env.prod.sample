# Production Environment Configuration
ENVIRONMENT=prod

# API Configuration
API_PORT=2125

# Database Configuration - Site DB
SITE_DB_HOST=site-db
SITE_DB_PORT=5432
SITE_DB_NAME=site
SITE_DB_USER=postgres
SITE_DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Database Configuration - Search Engine DB
SE_DB_HOST=se-db
SE_DB_PORT=5433
SE_DB_NAME=search
SE_DB_USER=postgres
SE_DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Postgres Versions
POSTGRES_VERSION=16
PGVECTOR_VERSION=pg16

# AI Configuration
AI_ENDPOINT=http://local-ai:8080/v1
AI_DENSE_MODEL=granite-embedding-278m-multilingual
AI_SPARSE_MODEL=text-embedding-splade-v3

# Application Settings
SAFE_MODE=true
WIPE_ON_START=false
MIGRATE=true
SEED_DATABASE=false

# Cloudflare Tunnel (set your production token)
CLOUDFLARED_TOKEN=your-prod-token-here

# Crawler Configuration
CRAWLER_PORT=9900
